<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-FileCopyrightText: 2026 SymbiotOS
    SPDX-License-Identifier: Apache-2.0

    Privapp permissions for com.android.walkietalkie (Walkie-Talkie intercom app).
    Grants signature|privileged permissions that WalkieTalkie declares via
    uses-permission. Without this allowlist, WalkieTalkie installed at
    /system_ext/priv-app/WalkieTalkie/ would fail to acquire the permissions
    despite being a privileged system app.

    This app requires UART access (/dev/ttyS0) and intercom device access
    (/dev/intercom_device) for hardware radio communication.
-->
<permissions>
    <privapp-permissions package="com.android.walkietalkie">
        <!-- System-level permissions -->
        <permission name="android.permission.MASTER_CLEAR"/>
        <permission name="android.permission.INSTALL_PACKAGES"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        <permission name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
        <permission name="android.permission.SYSTEM_ALERT_WINDOW"/>
        <permission name="android.permission.RECOVERY"/>
        <permission name="android.permission.DEVICE_POWER"/>
        <permission name="android.permission.MOUNT_UNMOUNT_FILESYSTEMS"/>
        <permission name="android.permission.CONFIGURE_WIFI_DISPLAY"/>
        <permission name="android.permission.BIND_INCALL_SERVICE"/>
        <permission name="android.permission.WRITE_SETTINGS"/>
        <permission name="android.permission.CONFIGURE_DISPLAY_COLOR_MODE"/>
        <permission name="android.permission.LOCATION_BYPASS"/>
        <permission name="android.permission.BIND_ATTENTION_SERVICE"/>
        <permission name="android.permission.STORAGE_INTERNAL"/>
        <permission name="android.permission.USE_CREDENTIALS"/>
        <permission name="android.permission.MODIFY_AUDIO_SETTINGS"/>
        <permission name="android.permission.ACCESS_CHECKIN_PROPERTIES"/>
        <permission name="android.permission.MODIFY_AUDIO_ROUTING"/>
        <permission name="android.permission.QUERY_AUDIO_STATE"/>
        <permission name="android.permission.INSTALL_LOCATION_PROVIDER"/>
        <permission name="android.permission.USE_RESERVED_DISK"/>
        <permission name="android.permission.BROADCAST_PHONE_ACCOUNT_REGISTRATION"/>
        <permission name="android.permission.CLEAR_APP_USER_DATA"/>
        <permission name="android.permission.BROADCAST_CALLLOG_INFO"/>

        <!-- Runtime permissions (granted via SYSTEM_FIXED) -->
        <permission name="android.permission.RECORD_AUDIO"/>
        <permission name="android.permission.CAMERA"/>
        <permission name="android.permission.CALL_PHONE"/>
        <permission name="android.permission.SEND_SMS"/>
        <permission name="android.permission.READ_CONTACTS"/>
        <permission name="android.permission.WRITE_CONTACTS"/>
        <permission name="android.permission.READ_CALL_LOG"/>
        <permission name="android.permission.WRITE_CALL_LOG"/>
        <permission name="android.permission.ACCESS_FINE_LOCATION"/>
        <permission name="android.permission.ACCESS_COARSE_LOCATION"/>
        <permission name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
        <permission name="android.permission.BLUETOOTH_CONNECT"/>
        <permission name="android.permission.BLUETOOTH_SCAN"/>
        <permission name="android.permission.BLUETOOTH_ADVERTISE"/>
        <permission name="android.permission.POST_NOTIFICATIONS"/>
        <permission name="android.permission.READ_CALENDAR"/>
        <permission name="android.permission.READ_PHONE_STATE"/>
        <permission name="android.permission.PROCESS_OUTGOING_CALLS"/>
        <permission name="android.permission.GET_ACCOUNTS"/>
        <permission name="android.permission.READ_EXTERNAL_STORAGE"/>
        <permission name="android.permission.WRITE_EXTERNAL_STORAGE"/>
        <permission name="android.permission.READ_MEDIA_IMAGES"/>
        <permission name="android.permission.READ_MEDIA_AUDIO"/>
        <permission name="android.permission.READ_MEDIA_VIDEO"/>
        <permission name="android.permission.RECEIVE_WAP_PUSH"/>

        <!-- Mediatek-specific permissions -->
        <permission name="com.mediatek.permission.CTA_CONFERENCE_CALL"/>
        <permission name="com.mediatek.permission.CTA_CALL_FORWARD"/>
    </privapp-permissions>
</permissions>
